# ══════════════════════════════════════════
# AI SELLER — Environment Configuration
# ══════════════════════════════════════════
# Copy to .env and fill in real values.
# NEVER commit .env to git.

# ── Telegram ──────────────────────────────
BOT_TOKEN=your_bot_token_here
OWNER_CHAT_ID=your_telegram_id_here
WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
WEBHOOK_SECRET=your_random_webhook_secret_here

# ── Database ──────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ai_seller

# ── Universal AI Provider ─────────────────
# Works with OpenRouter, any OpenAI-compatible API, or custom endpoints.
# Switch provider by changing AI_BASE_URL + AI_API_KEY only.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=openai/gpt-4o-mini
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=30000
AI_TOKEN_LIMIT=1000000

# Examples:
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1
#   Anthropic:   AI_BASE_URL=https://api.anthropic.com/v1
#   Local:       AI_BASE_URL=http://localhost:11434/v1

# ── Shop API (optional) ───────────────────
SHOP_API_URL=https://your-shop.com/api
SHOP_API_KEY=your_shop_api_key_here

# ── Server ────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Frontend ──────────────────────────────
FRONTEND_URL=https://your-domain.com

# ── Auth (REQUIRED in production) ────────
# Generate: openssl rand -base64 32
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_random_jwt_secret_at_least_32_chars
