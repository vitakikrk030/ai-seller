{
  "name": "telegram-ai-relay",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js",
    "test": "node --test tests/*.test.js",
    "backfill:crm-sales": "node scripts/backfill-crm-sales-history.js",
    "backfill:crm-dialog-state": "node scripts/backfill-crm-dialog-state.js",
    "repair:crm-customers": "node scripts/repair-business-chat-customers.js",
    "repair:crm-avatars": "node scripts/repair-customer-avatars.js",
    "db:start": "pg_ctl -D data/postgres -o \"-p 55432\" -l logs/postgres.log start",
    "db:stop": "pg_ctl -D data/postgres stop",
    "db:status": "pg_ctl -D data/postgres status"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.20.0"
  }
}
